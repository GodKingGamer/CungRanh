rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Hồ sơ riêng: chỉ chủ tài khoản đọc/ghi
    match /data/users/{uid}/{doc=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Mã mời: biết mã mới đọc được, không liệt kê được
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn();
      allow delete: if signedIn();
    }

    match /groups/{gid} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      function isOwner() { return get(/databases/$(database)/documents/groups/$(gid)).data.ownerId == request.auth.uid; }

      match /members/{uid} {
        allow read: if signedIn();
        allow write: if signedIn() && (request.auth.uid == uid || isOwner());
      }
      match /events/{eid} {
        allow read, write: if signedIn();
      }
    }
  }
}
